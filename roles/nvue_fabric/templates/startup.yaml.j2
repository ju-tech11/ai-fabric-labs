{# 용도: 스위치 1대(리프/스파인 공통)의 NVUE 설정 틀. features/*.j2 조각을 조립 #}
{% set my_links = fabric_links_all | selectattr('leaf', 'equalto', inventory_hostname) | list %}
{% set my_up = [] %}
{% for u in fabric_uplinks_all %}
{% if u.leaf == inventory_hostname %}{% set _ = my_up.append({'port': u.leaf_port, 'peer': u.spine ~ ':' ~ u.spine_port}) %}{% endif %}
{% if u.spine == inventory_hostname %}{% set _ = my_up.append({'port': u.spine_port, 'peer': u.leaf ~ ':' ~ u.leaf_port}) %}{% endif %}
{% endfor %}
{% set loopback = loopback_format.format(id=id) %}
- set:
{% include 'features/system.j2' %}
{% include 'features/interface.j2' %}
{% if my_links %}
{% include 'features/bridge.j2' %}
{% endif %}
{% include 'features/qos.j2' %}
{% include 'features/router.j2' %}
