/* 용도: compute-rail-nospine Air 토폴로지 (gen_topology.yml이 인벤토리로 생성). OOB는 Air가 자동 생성.
   ※ 관리 IP(eth0) 지정은 JSON 파일에만 들어 있음 → import는 .json 권장 */
graph "compute-rail-nospine" {
  "leaf-a-01" [function="leaf" os="cumulus-vx-5.16.1" cpu="2" memory="4096" storage="20"]
  "leaf-a-02" [function="leaf" os="cumulus-vx-5.16.1" cpu="2" memory="4096" storage="20"]
